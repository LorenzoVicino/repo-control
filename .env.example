# API bind address. Keep this on localhost for normal use.
HOST=127.0.0.1

# API port.
PORT=3747

# Fastify log level: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=error

# Folder scanned for Git repositories.
REPO_CONTROL_ROOT=~/projects

# Optional: directory for preferences, terminal history, workflows, and run history.
# REPO_CONTROL_CONFIG_DIR=/path/to/repo-control-config

# Optional: shell used by project terminal commands and automation nodes.
# REPO_CONTROL_SHELL=/bin/bash

# Optional: full launcher path when VS Code is not available in PATH.
# REPO_CONTROL_VSCODE=/path/to/code

# Optional: agent CLI commands when they are not available in PATH.
# REPO_CONTROL_CLAUDE=/path/to/claude
# REPO_CONTROL_CODEX=/path/to/codex
# REPO_CONTROL_GEMINI=/path/to/gemini

# Optional: graphical terminal used to resume agent sessions (must support -e).
# REPO_CONTROL_TERMINAL=/path/to/terminal

# Optional under WSL: full path to Windows Terminal when wt.exe is not discoverable.
# REPO_CONTROL_WINDOWS_TERMINAL=/mnt/c/Users/you/AppData/Local/Microsoft/WindowsApps/wt.exe
