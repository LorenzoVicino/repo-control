# API bind address. Keep this on localhost for normal use.
HOST=127.0.0.1

# API port.
PORT=3747

# Folder scanned for Git repositories.
REPO_CONTROL_ROOT=~/projects

# Optional: free API Ninjas key used for Dashboard quotes.
# API_NINJAS_API_KEY=your_api_key

# Optional: full launcher path when VS Code is not available in PATH.
# REPO_CONTROL_VSCODE=/path/to/code
