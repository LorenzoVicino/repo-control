{
  "name": "repo-control",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first command center for inspecting, operating and automating multi-repository workspaces.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.cjs",
    "preinstall": "node scripts/check-node-version.cjs",
    "predev": "node scripts/check-node-version.cjs",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx apps/server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1 apps/web",
    "build": "npm run typecheck && vite build apps/web",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node scripts/run-tests.cjs",
    "test:server:coverage": "c8 --all --include=apps/server/src/**/*.ts --exclude=apps/server/src/**/*.test.ts --exclude=apps/server/src/**/types.ts --check-coverage --lines=35 --branches=75 --functions=34 --statements=35 npm run test:server",
    "test:web": "vitest run --config vitest.config.ts",
    "test:web:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:coverage": "npm run test:server:coverage && npm run test:web:coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck",
    "verify": "npm run check && npm run test:coverage && npm run build",
    "lint": "eslint apps/server/src apps/web/src apps/web/vite.config.ts e2e vitest.config.ts playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fastify/cors": "^11.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.2",
    "fastify": "^5.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git": "^3.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
